+enum {
+  DOSXC_M_DOWN,
+  DOSXC_M_UP,
+  DOSXC_M_MOVE,
+  DOSXC_M_DOUBLE,
+  DOSXC_M_WHEEL,
+  DOSXC_M_RIGHT
+};
