diff --git a/media/libcubeb/src/cubeb_dosxc.c b/media/libcubeb/src/cubeb_dosxc.c
new file mode 100644
index 0000000000..7005333388
--- /dev/null
+++ b/media/libcubeb/src/cubeb_dosxc.c
@@ -0,0 +1,386 @@
+/*
+ * Copyright (c) 2026 Ben Daws
+ *
+ * This program is made available under an ISC-style license.  See the
+ * accompanying file LICENSE for details.
+ *
+ * Output on DOS-XC through its audio system call.  The device plays one
+ * 48 kHz stereo 16-bit stream, so a single thread mixes every running stream
+ * into it.  Gecko resamples to that rate before it gets here
+ * (media.resampling.enabled).
+ */
+#include "cubeb-internal.h"
+#include "cubeb/cubeb.h"
+#include <dosxc/abi.h>
+#include <dosxc/syscall.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define DOSXC_RATE 48000
+#define DOSXC_CHANNELS 2
+#define DOSXC_PERIOD 1024
+#define DOSXC_TARGET 4096
+#define DOSXC_MAX_STREAMS 8
+
+struct cubeb {
+  struct cubeb_ops const * ops;
+  pthread_mutex_t lock;
+  pthread_cond_t wake;
+  pthread_t thread;
+  int thread_started, quit, device_open;
+  struct cubeb_stream * streams[DOSXC_MAX_STREAMS];
+  uint64_t written;
+  uint64_t buffered;
+};
+
+struct cubeb_stream {
+  struct cubeb * context;
+  void * user_ptr;
+  cubeb_data_callback data_callback;
+  cubeb_state_callback state_callback;
+  cubeb_sample_format format;
+  unsigned channels;
+  float volume;
+  int running;
+  uint64_t frames_written;
+  uint64_t last_position;
+};
+
+static struct cubeb_ops const dosxc_ops;
+
+static void
+mix_stream(cubeb_stream * s, int32_t * mix, void * scratch)
+{
+  long got = s->data_callback(s, s->user_ptr, NULL, scratch, DOSXC_PERIOD);
+  if (got < 0) {
+    s->running = 0;
+    s->state_callback(s, s->user_ptr, CUBEB_STATE_ERROR);
+    return;
+  }
+  for (long i = 0; i < got; ++i) {
+    for (unsigned c = 0; c < DOSXC_CHANNELS; ++c) {
+      unsigned from = s->channels == 1 ? (unsigned)i : (unsigned)i * 2 + c;
+      float v = s->format == CUBEB_SAMPLE_FLOAT32NE
+                    ? ((float *)scratch)[from] * 32767.0f
+                    : (float)((int16_t *)scratch)[from];
+      mix[i * 2 + c] += (int32_t)(v * s->volume);
+    }
+  }
+  s->frames_written += (uint64_t)got;
+  if (got < DOSXC_PERIOD) {
+    s->running = 0;
+    s->state_callback(s, s->user_ptr, CUBEB_STATE_DRAINED);
+  }
+}
+
+static void
+fail_all(cubeb * ctx)
+{
+  for (int i = 0; i < DOSXC_MAX_STREAMS; ++i) {
+    cubeb_stream * s = ctx->streams[i];
+    if (s && s->running) {
+      s->running = 0;
+      s->state_callback(s, s->user_ptr, CUBEB_STATE_ERROR);
+    }
+  }
+}
+
+static void
+close_device(cubeb * ctx)
+{
+  if (ctx->device_open) {
+    dosxc_sys_audio(DOSXC_AUDIO_CLOSE, 0, 0);
+    ctx->device_open = 0;
+  }
+}
+
+static void *
+mixer_thread(void * arg)
+{
+  cubeb * ctx = arg;
+  static int32_t mix[DOSXC_PERIOD * DOSXC_CHANNELS];
+  static int16_t out[DOSXC_PERIOD * DOSXC_CHANNELS];
+  static float scratch[DOSXC_PERIOD * DOSXC_CHANNELS];
+
+  pthread_mutex_lock(&ctx->lock);
+  while (!ctx->quit) {
+    int any = 0;
+    for (int i = 0; i < DOSXC_MAX_STREAMS; ++i) {
+      any |= ctx->streams[i] && ctx->streams[i]->running;
+    }
+    if (!any) {
+      close_device(ctx);
+      pthread_cond_wait(&ctx->wake, &ctx->lock);
+      continue;
+    }
+    if (!ctx->device_open) {
+      if (dosxc_sys_audio(DOSXC_AUDIO_OPEN, DOSXC_RATE, DOSXC_CHANNELS) < 0) {
+        fail_all(ctx);
+        continue;
+      }
+      ctx->device_open = 1;
+      ctx->written = 0;
+      ctx->buffered = 0;
+    }
+    uint64_t played = 0;
+    dosxc_sys_audio(DOSXC_AUDIO_POSITION, (__dosxc_word)&played, 0);
+    ctx->buffered = ctx->written > played ? ctx->written - played : 0;
+    if (ctx->buffered >= DOSXC_TARGET) {
+      pthread_mutex_unlock(&ctx->lock);
+      usleep(4000);
+      pthread_mutex_lock(&ctx->lock);
+      continue;
+    }
+
+    memset(mix, 0, sizeof(mix));
+    for (int i = 0; i < DOSXC_MAX_STREAMS; ++i) {
+      if (ctx->streams[i] && ctx->streams[i]->running) {
+        mix_stream(ctx->streams[i], mix, scratch);
+      }
+    }
+    for (int i = 0; i < DOSXC_PERIOD * DOSXC_CHANNELS; ++i) {
+      int32_t v = mix[i];
+      out[i] = (int16_t)(v > 32767 ? 32767 : v < -32768 ? -32768 : v);
+    }
+    int done = 0;
+    while (done < DOSXC_PERIOD && !ctx->quit) {
+      long taken = dosxc_sys_audio(DOSXC_AUDIO_WRITE,
+                                   (__dosxc_word)(out + done * DOSXC_CHANNELS),
+                                   DOSXC_PERIOD - done);
+      if (taken < 0) {
+        ctx->device_open = 0;
+        fail_all(ctx);
+        break;
+      }
+      done += (int)taken;
+      if (done < DOSXC_PERIOD) {
+        pthread_mutex_unlock(&ctx->lock);
+        usleep(2000);
+        pthread_mutex_lock(&ctx->lock);
+      }
+    }
+    ctx->written += (uint64_t)done;
+  }
+  close_device(ctx);
+  pthread_mutex_unlock(&ctx->lock);
+  return NULL;
+}
+
+int
+dosxc_init(cubeb ** context, char const * context_name)
+{
+  (void)context_name;
+  long r = dosxc_sys_audio(DOSXC_AUDIO_OPEN, DOSXC_RATE, DOSXC_CHANNELS);
+  if (r < 0 && r != -DOSXC_EBUSY) {
+    return CUBEB_ERROR;                 /* no sound device */
+  }
+  if (r == 0) {
+    dosxc_sys_audio(DOSXC_AUDIO_CLOSE, 0, 0);
+  }
+  cubeb * ctx = calloc(1, sizeof(*ctx));
+  if (!ctx) {
+    return CUBEB_ERROR;
+  }
+  ctx->ops = &dosxc_ops;
+  pthread_mutex_init(&ctx->lock, NULL);
+  pthread_cond_init(&ctx->wake, NULL);
+  if (pthread_create(&ctx->thread, NULL, mixer_thread, ctx)) {
+    free(ctx);
+    return CUBEB_ERROR;
+  }
+  ctx->thread_started = 1;
+  *context = ctx;
+  return CUBEB_OK;
+}
+
+static char const *
+dosxc_get_backend_id(cubeb * ctx)
+{
+  (void)ctx;
+  return "dosxc";
+}
+
+static int
+dosxc_get_max_channel_count(cubeb * ctx, uint32_t * channels)
+{
+  (void)ctx;
+  *channels = DOSXC_CHANNELS;
+  return CUBEB_OK;
+}
+
+static int
+dosxc_get_min_latency(cubeb * ctx, cubeb_stream_params params, uint32_t * frames)
+{
+  (void)ctx;
+  (void)params;
+  *frames = DOSXC_PERIOD;
+  return CUBEB_OK;
+}
+
+static int
+dosxc_get_preferred_sample_rate(cubeb * ctx, uint32_t * rate)
+{
+  (void)ctx;
+  *rate = DOSXC_RATE;
+  return CUBEB_OK;
+}
+
+static void
+dosxc_destroy(cubeb * ctx)
+{
+  pthread_mutex_lock(&ctx->lock);
+  ctx->quit = 1;
+  pthread_cond_signal(&ctx->wake);
+  pthread_mutex_unlock(&ctx->lock);
+  if (ctx->thread_started) {
+    pthread_join(ctx->thread, NULL);
+  }
+  pthread_mutex_destroy(&ctx->lock);
+  pthread_cond_destroy(&ctx->wake);
+  free(ctx);
+}
+
+static int
+dosxc_stream_init(cubeb * ctx, cubeb_stream ** stream, char const * name,
+                  cubeb_devid input_device, cubeb_stream_params * input,
+                  cubeb_devid output_device, cubeb_stream_params * output,
+                  unsigned int latency, cubeb_data_callback data_callback,
+                  cubeb_state_callback state_callback, void * user_ptr)
+{
+  (void)name;
+  (void)input_device;
+  (void)output_device;
+  (void)latency;
+  if (input || !output) {
+    return CUBEB_ERROR_NOT_SUPPORTED;
+  }
+  if (output->rate != DOSXC_RATE || output->channels < 1 ||
+      output->channels > DOSXC_CHANNELS ||
+      (output->format != CUBEB_SAMPLE_S16NE &&
+       output->format != CUBEB_SAMPLE_FLOAT32NE)) {
+    return CUBEB_ERROR_INVALID_FORMAT;
+  }
+  cubeb_stream * s = calloc(1, sizeof(*s));
+  if (!s) {
+    return CUBEB_ERROR;
+  }
+  s->context = ctx;
+  s->user_ptr = user_ptr;
+  s->data_callback = data_callback;
+  s->state_callback = state_callback;
+  s->format = output->format;
+  s->channels = output->channels;
+  s->volume = 1.0f;
+
+  int result = CUBEB_ERROR;
+  pthread_mutex_lock(&ctx->lock);
+  for (int i = 0; i < DOSXC_MAX_STREAMS; ++i) {
+    if (!ctx->streams[i]) {
+      ctx->streams[i] = s;
+      result = CUBEB_OK;
+      break;
+    }
+  }
+  pthread_mutex_unlock(&ctx->lock);
+  if (result != CUBEB_OK) {
+    free(s);
+    return result;
+  }
+  *stream = s;
+  return CUBEB_OK;
+}
+
+static void
+dosxc_stream_destroy(cubeb_stream * s)
+{
+  cubeb * ctx = s->context;
+  pthread_mutex_lock(&ctx->lock);
+  for (int i = 0; i < DOSXC_MAX_STREAMS; ++i) {
+    if (ctx->streams[i] == s) {
+      ctx->streams[i] = NULL;
+    }
+  }
+  pthread_mutex_unlock(&ctx->lock);
+  free(s);
+}
+
+static int
+dosxc_stream_start(cubeb_stream * s)
+{
+  cubeb * ctx = s->context;
+  pthread_mutex_lock(&ctx->lock);
+  s->running = 1;
+  pthread_cond_signal(&ctx->wake);
+  pthread_mutex_unlock(&ctx->lock);
+  s->state_callback(s, s->user_ptr, CUBEB_STATE_STARTED);
+  return CUBEB_OK;
+}
+
+static int
+dosxc_stream_stop(cubeb_stream * s)
+{
+  cubeb * ctx = s->context;
+  pthread_mutex_lock(&ctx->lock);
+  s->running = 0;
+  pthread_mutex_unlock(&ctx->lock);
+  s->state_callback(s, s->user_ptr, CUBEB_STATE_STOPPED);
+  return CUBEB_OK;
+}
+
+/* Called from inside the data callback too, so it takes no lock. */
+static int
+dosxc_stream_get_position(cubeb_stream * s, uint64_t * position)
+{
+  uint64_t buffered = s->context->buffered;
+  uint64_t now = s->frames_written > buffered ? s->frames_written - buffered : 0;
+  if (now < s->last_position) {
+    now = s->last_position;
+  }
+  s->last_position = now;
+  *position = now;
+  return CUBEB_OK;
+}
+
+static int
+dosxc_stream_get_latency(cubeb_stream * s, uint32_t * latency)
+{
+  (void)s;
+  *latency = DOSXC_TARGET;
+  return CUBEB_OK;
+}
+
+static int
+dosxc_stream_set_volume(cubeb_stream * s, float volume)
+{
+  s->volume = volume;
+  return CUBEB_OK;
+}
+
+static struct cubeb_ops const dosxc_ops = {
+    .init = dosxc_init,
+    .get_backend_id = dosxc_get_backend_id,
+    .get_max_channel_count = dosxc_get_max_channel_count,
+    .get_min_latency = dosxc_get_min_latency,
+    .get_preferred_sample_rate = dosxc_get_preferred_sample_rate,
+    .get_supported_input_processing_params = NULL,
+    .enumerate_devices = NULL,
+    .device_collection_destroy = NULL,
+    .destroy = dosxc_destroy,
+    .stream_init = dosxc_stream_init,
+    .stream_destroy = dosxc_stream_destroy,
+    .stream_start = dosxc_stream_start,
+    .stream_stop = dosxc_stream_stop,
+    .stream_get_position = dosxc_stream_get_position,
+    .stream_get_latency = dosxc_stream_get_latency,
+    .stream_get_input_latency = NULL,
+    .stream_set_volume = dosxc_stream_set_volume,
+    .stream_set_name = NULL,
+    .stream_get_current_device = NULL,
+    .stream_set_input_mute = NULL,
+    .stream_set_input_processing_params = NULL,
+    .stream_device_destroy = NULL,
+    .stream_register_device_changed_callback = NULL,
+    .register_device_collection_changed = NULL};
