+// Connects on the first call; false when the desktop is not running.
+bool Available();
+void ScreenSize(int* aWidth, int* aHeight);
+void ShowWindow(HeadlessWidget* aWidget, bool aShow, bool aPopup);
+void CloseWindow(HeadlessWidget* aWidget);
+void SetTitle(HeadlessWidget* aWidget, const nsAString& aTitle);
+void WidgetResized(HeadlessWidget* aWidget, int aWidth, int aHeight);
+void WidgetMoved(HeadlessWidget* aWidget, int aX, int aY);
