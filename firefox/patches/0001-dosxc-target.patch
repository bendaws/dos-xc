+
+class nsUserIdleServiceDosxc : public nsUserIdleService {
+ public:
+  NS_INLINE_DECL_REFCOUNTING_INHERITED(nsUserIdleServiceDosxc,
+                                       nsUserIdleService)
+
+  bool PollIdleTime(uint32_t* aIdleTime) override;
+
+  static already_AddRefed<nsUserIdleServiceDosxc> GetInstance() {
+    RefPtr<nsUserIdleService> idleService = nsUserIdleService::GetInstance();
+    if (!idleService) {
+      // Avoid late instantiation or resurrection during shutdown.
+      if (mozilla::AppShutdown::IsInOrBeyond(
+              mozilla::ShutdownPhase::AppShutdownConfirmed)) {
+        return nullptr;
+      }
+      idleService = new nsUserIdleServiceDosxc();
+    }
+
+    return idleService.forget().downcast<nsUserIdleServiceDosxc>();
+  }
+
+ protected:
+  nsUserIdleServiceDosxc() {}
+  virtual ~nsUserIdleServiceDosxc() {}
+};
+
+#endif  // nsUserIdleServiceDosxc_h_
