+
+// Windows on the DOS-XC desktop for the headless widget, which does
+// everything else: Gecko believes it is headless and these show the result.
+
+#ifndef widget_dosxc_DosxcDesktop_h
+#define widget_dosxc_DosxcDesktop_h
+
+#include "mozilla/AlreadyAddRefed.h"
