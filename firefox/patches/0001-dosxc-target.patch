+#if defined(MOZ_WIDGET_DOSXC)
+// DOS-XC has no fork: the kernel starts the child with exactly the
+// descriptors listed.
+Result<Ok, LaunchError> LaunchApp(const std::vector<std::string>& argv,
+                                  LaunchOptions&& options,
+                                  ProcessHandle* process_handle) {
+  EnvironmentArray env_storage;
+  const EnvironmentArray& envp =
+      options.full_env ? options.full_env
+                       : (env_storage = BuildEnvironmentArray(options.env_map));
+
+  // Standard output and error are passed on; standard input is not, so a
+  // child cannot read the console's keys.
+  std::vector<int> map;
+  bool mapped[3] = {false, false, false};
+  for (const auto& fds : options.fds_to_remap) {
+    map.push_back(fds.first);
+    map.push_back(fds.second);
+    if (fds.second >= 0 && fds.second < 3) mapped[fds.second] = true;
+  }
+  for (int fd = 1; fd < 3; ++fd) {
+    if (!mapped[fd] && fcntl(fd, F_GETFD) >= 0) {
+      map.push_back(fd);
+      map.push_back(fd);
+    }
+  }
+
+  std::vector<char*> argv_cstr;
+  for (const auto& arg : argv) argv_cstr.push_back(const_cast<char*>(arg.c_str()));
+  argv_cstr.push_back(nullptr);
+
+  pid_t pid = -1;
+  int error = dosxc_spawn_fds(&pid, argv_cstr[0], argv_cstr.data(), envp.get(),
+                              map.data(), int(map.size() / 2));
+  if (error) {
+    CHROMIUM_LOG(WARNING) << "dosxc_spawn_fds failed: " << strerror(error);
+    return Err(LaunchError("dosxc_spawn_fds", error));
