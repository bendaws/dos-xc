+
+#include "nsLookAndFeel.h"
+
+#include "gfxFont.h"
+
+using namespace mozilla;
+
+nsresult nsLookAndFeel::NativeGetInt(IntID aID, int32_t& aResult) {
+  switch (aID) {
+    case IntID::CaretBlinkTime:
+      aResult = 567;
+      return NS_OK;
+    case IntID::CaretWidth:
+      aResult = 1;
+      return NS_OK;
+    case IntID::SubmenuDelay:
+      aResult = 200;
+      return NS_OK;
+    case IntID::DragThresholdX:
+    case IntID::DragThresholdY:
+      aResult = 4;
+      return NS_OK;
+    default:
+      aResult = 0;
+      return NS_ERROR_FAILURE;
+  }
+}
+
+nsresult nsLookAndFeel::NativeGetFloat(FloatID, float& aResult) {
+  aResult = -1.0f;
+  return NS_ERROR_FAILURE;
+}
+
+// Not yet connected to the desktop's theme.
+nsresult nsLookAndFeel::NativeGetColor(ColorID aID, ColorScheme,
+                                       nscolor& aResult) {
+  switch (aID) {
+    case ColorID::Window:
+    case ColorID::Field:
+    case ColorID::MozCombobox:
+      aResult = NS_RGB(0xff, 0xff, 0xff);
+      break;
+    case ColorID::Highlight:
+    case ColorID::Selecteditem:
+      aResult = NS_RGB(0x33, 0x66, 0xcc);
+      break;
+    case ColorID::Highlighttext:
+    case ColorID::Selecteditemtext:
+      aResult = NS_RGB(0xff, 0xff, 0xff);
+      break;
+    case ColorID::Buttonface:
+    case ColorID::Menu:
+    case ColorID::Activeborder:
+    case ColorID::Threedface:
+    case ColorID::MozDialog:
+      aResult = NS_RGB(0xe0, 0xe0, 0xe0);
+      break;
+    case ColorID::Background:
+    case ColorID::Infobackground:
+      aResult = NS_RGB(0xff, 0xff, 0xe1);
+      break;
+    case ColorID::Scrollbar:
+    case ColorID::ThemedScrollbar:
+      aResult = NS_RGB(0xec, 0xec, 0xec);
+      break;
+    case ColorID::ThemedScrollbarThumb:
+      aResult = NS_RGB(0xa0, 0xa0, 0xa0);
+      break;
+    case ColorID::ThemedScrollbarThumbHover:
+    case ColorID::ThemedScrollbarThumbActive:
+      aResult = NS_RGB(0x80, 0x80, 0x80);
+      break;
+    default:
+      aResult = NS_RGB(0, 0, 0);
+      break;
+  }
+  return NS_OK;
+}
+
+bool nsLookAndFeel::NativeGetFont(FontID, nsString& aFontName,
+                                  gfxFontStyle& aFontStyle) {
+  aFontName.AssignLiteral("sans-serif");
+  aFontStyle.style = FontSlantStyle::NORMAL;
+  aFontStyle.weight = FontWeight::NORMAL;
+  aFontStyle.width = FontWidth::NORMAL;
+  aFontStyle.size = 14;
+  aFontStyle.systemFont = true;
+  return true;
+}
