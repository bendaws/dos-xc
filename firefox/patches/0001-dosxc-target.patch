+#  ifdef MOZ_WIDGET_DOSXC
+#    include <dlfcn.h>
+#    include <stdio.h>
+#    include <unistd.h>
+// Writing to address 0, which is how MOZ_CRASH stops the program elsewhere,
+// does not fault here.  Say why we stopped and what was on the stack.
+extern "C" void abort(void) {
+  static int aborting;
+  if (aborting++) {
+    _exit(127);
+  }
+  char line[300];
+  auto say = [&line]() {
+    fputs(line, stderr);
+    for (const char* c = line; *c; ++c) {
+      __asm__("outb %b0, $0xe9" : : "a"(*c));
+    }
+  };
+  snprintf(line, sizeof(line), "Firefox stopped: %s\n",
+           gMozCrashReason ? gMozCrashReason : "abort()");
+  say();
+  void** stack = reinterpret_cast<void**>(__builtin_frame_address(0));
+  int shown = 0;
+  for (int i = 0; i < 1024 && shown < 40; i++) {
+    Dl_info info;
+    if (stack[i] && dladdr(stack[i], &info) && info.dli_fname) {
+      snprintf(line, sizeof(line), "  %s+0x%lx\n", info.dli_fname,
+               (unsigned long)((char*)stack[i] - (char*)info.dli_fbase));
+      say();
+      shown++;
+    }
+  }
+  _exit(127);
+}
+#  else
