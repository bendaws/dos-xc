diff --git a/widget/dosxc/DosxcBoard.c b/widget/dosxc/DosxcBoard.c
new file mode 100644
index 0000000000..b14e1fc281
--- /dev/null
+++ b/widget/dosxc/DosxcBoard.c
@@ -0,0 +1,171 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "DosxcBoard.h"
+
+#include "wm.h"
+
+static struct gui_board* board;
+static struct gui_client* self;
+
+int dosxc_gui_connect(void) {
+  board = (struct gui_board*)dosxc_sys_task(DOSXC_TASK_SHARE_GET, 0, 0, 0);
+  if (!board || board->magic != GUI_MAGIC) {
+    board = 0;
+    return -1;
+  }
+  int pid = dosxc_sys_getpid();
+  for (int i = 0; i < GUI_CLIENTS; ++i) {
+    if (__sync_bool_compare_and_swap(&board->clients[i].pid, 0, pid)) {
+      self = &board->clients[i];
+      return 0;
+    }
+  }
+  board = 0;
+  return -1;
+}
+
+void dosxc_gui_screen(int* w, int* h) {
+  *w = board ? board->screen_w : 0;
+  *h = board ? board->screen_h : 0;
+}
+
+static void request(const struct gui_request* r) {
+  u32 next = (self->rq_write + 1) % GUI_REQUESTS;
+  while (next == self->rq_read) {
+    dosxc_sys_sleep(2000000);
+  }
+  self->requests[self->rq_write] = *r;
+  __sync_synchronize();
+  self->rq_write = next;
+}
+
+static void simple(int type, struct window* w, int x, int y) {
+  struct gui_request r;
+  memset(&r, 0, sizeof(r));
+  r.type = type;
+  r.window = (uintptr_t)w;
+  r.x = x;
+  r.y = y;
+  request(&r);
+}
+
+// The desktop may still be drawing an old buffer, and the renderer filling
+// one: buffers are freed a few resizes later.
+#define RETIRED 6
+struct pixels {
+  u32* old[RETIRED];
+  int next;
+};
+
+static int replace_pixels(struct window* w, int width, int height) {
+  u32* px = calloc((size_t)width * (size_t)height, sizeof(u32));
+  if (!px) {
+    return -1;
+  }
+  struct pixels* held = w->data;
+  free(held->old[held->next]);
+  held->old[held->next] = w->content.px;
+  held->next = (held->next + 1) % RETIRED;
+  w->content.w = width;
+  w->content.h = height;
+  w->content.capacity = width * height;
+  __sync_synchronize();
+  w->content.px = px;
+  return 0;
+}
+
+void* dosxc_gui_open(int x, int y, int width, int height, const char* title,
+                     int popup) {
+  if (!self) {
+    return 0;
+  }
+  struct window* w = calloc(1, sizeof(*w));
+  if (!w) {
+    return 0;
+  }
+  w->data = calloc(1, sizeof(struct pixels));
+  if (!w->data || replace_pixels(w, width, height)) {
+    free(w->data);
+    free(w);
+    return 0;
+  }
+  w->r = (struct rect){x, y, width, height};
+  snprintf(w->title, sizeof(w->title), "%s", title);
+  w->icon = ICON_DOSFOX;
+  w->resizable = !popup;
+  w->popup = popup;
+  w->track_mouse = 1;
+  simple(RQ_OPEN, w, 0, 0);
+  return w;
+}
+
+void dosxc_gui_close(void* window) { simple(RQ_CLOSE, window, 0, 0); }
+
+void dosxc_gui_title(void* window, const char* title) {
+  struct window* w = window;
+  snprintf(w->title, sizeof(w->title), "%s", title);
+}
+
+void dosxc_gui_accept_size(void* window, int width, int height) {
+  struct window* w = window;
+  if (w->content.w == width && w->content.h == height) {
+    return;
+  }
+  if (!replace_pixels(w, width, height)) {
+    w->r.w = width;
+    w->r.h = height;
+    ++w->seq;
+  }
+}
+
+void dosxc_gui_size(void* window, int width, int height) {
+  struct window* w = window;
+  if (w->content.w == width && w->content.h == height) {
+    return;
+  }
+  if (!replace_pixels(w, width, height)) {
+    w->r.w = width;
+    w->r.h = height;
+    simple(RQ_RESIZE, w, width, height);
+    ++w->seq;
+  }
+}
+
+void dosxc_gui_place(void* window, int x, int y) {
+  struct window* w = window;
+  w->r.x = x;
+  w->r.y = y;
+}
+
+void dosxc_gui_position(void* window, int* x, int* y) {
+  struct window* w = window;
+  *x = w->r.x;
+  *y = w->r.y;
+}
+
+uint32_t* dosxc_gui_pixels(void* window, int* width, int* height) {
+  struct window* w = window;
+  *width = w->content.w;
+  *height = w->content.h;
+  return w->content.px;
+}
+
+void dosxc_gui_presented(void* window) { ++((struct window*)window)->seq; }
+
+int dosxc_gui_next_event(struct dosxc_gui_event* out) {
+  if (!self || self->ev_read == self->ev_write) {
+    return 0;
+  }
+  __sync_synchronize();
+  struct gui_event e = self->events[self->ev_read];
+  self->ev_read = (self->ev_read + 1) % GUI_RING;
+  out->type = e.type;
+  out->x = e.x;
+  out->y = e.y;
+  out->kind = e.kind;
+  out->value = e.value;
+  out->window = (void*)e.window;
+  return 1;
+}
