+++ b/widget/dosxc/nsAppShell.cpp
@@ -0,0 +1,67 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsAppShell.h"
+
+#include <stdlib.h>
+
+#include "DosxcDesktop.h"
+#include "HeadlessScreenHelper.h"
+#include "mozilla/Hal.h"
+#include "mozilla/Sprintf.h"
+#include "mozilla/UniquePtr.h"
+#include "nsXULAppAPI.h"
+#include "mozilla/widget/ScreenManager.h"
+
+using namespace mozilla;
+namespace dosxc = mozilla::widget::dosxc;
+using mozilla::widget::HeadlessScreenHelper;
+using mozilla::widget::ScreenManager;
+
+nsAppShell::nsAppShell()
+    : mMutex("nsAppShell"), mCondVar(mMutex, "nsAppShell") {}
+
+nsresult nsAppShell::Init() {
+  // Every toolkit starts the hardware layer here; wake locks need it.
+  mozilla::hal::Init();
+  if (XRE_IsParentProcess()) {
+    if (dosxc::Available()) {
+      int width, height;
+      dosxc::ScreenSize(&width, &height);
+      if (width > 0) {
+        char size[16];
+        SprintfLiteral(size, "%d", width);
+        setenv("MOZ_HEADLESS_WIDTH", size, 1);
+        SprintfLiteral(size, "%d", height);
+        setenv("MOZ_HEADLESS_HEIGHT", size, 1);
+      }
+    }
+    ScreenManager& screens = ScreenManager::GetSingleton();
+    screens.SetHelper(std::make_unique<HeadlessScreenHelper>());
+  }
+  return nsBaseAppShell::Init();
+}
+
+void nsAppShell::ScheduleNativeEventCallback() {
+  MutexAutoLock lock(mMutex);
+  mPending = true;
+  mCondVar.Notify();
+}
+
+bool nsAppShell::ProcessNextNativeEvent(bool aMayWait) {
+  bool input = dosxc::Pump();
+  bool run;
+  {
+    MutexAutoLock lock(mMutex);
+    if (aMayWait && !mPending) {
+      mCondVar.Wait(TimeDuration::FromMilliseconds(10));
+    }
+    run = mPending;
+    mPending = false;
+  }
+  if (run) {
+    NativeEventCallback();
+  }
+  return run || input;
+}
diff --git a/widget/dosxc/nsAppShell.h b/widget/dosxc/nsAppShell.h
new file mode 100644
