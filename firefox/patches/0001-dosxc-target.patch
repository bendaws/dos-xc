diff --git a/widget/dosxc/DosxcDesktop.cpp b/widget/dosxc/DosxcDesktop.cpp
new file mode 100644
index 0000000000..ea8265993d
--- /dev/null
+++ b/widget/dosxc/DosxcDesktop.cpp
@@ -0,0 +1,373 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "DosxcDesktop.h"
+
+#include "DosxcBoard.h"
+#include "HeadlessWidget.h"
+#include "mozilla/MouseEvents.h"
+#include "mozilla/TextEvents.h"
+#include "mozilla/dom/WheelEventBinding.h"
+#include "mozilla/gfx/2D.h"
+#include "nsIRollupListener.h"
+#include "nsIWidgetListener.h"
+#include "nsTArray.h"
+
+namespace mozilla::widget::dosxc {
+
+namespace {
+
+struct Entry {
+  void* mGui;
+  RefPtr<HeadlessWidget> mWidget;
+  int mX, mY;
+};
+
+nsTArray<Entry> sWindows;
+int sConnected = -1;
+int16_t sButtons = 0;
+
+Entry* Find(void* aGui) {
+  for (auto& entry : sWindows) {
+    if (entry.mGui == aGui) {
+      return &entry;
+    }
+  }
+  return nullptr;
+}
+
+void RollupIfOutside(HeadlessWidget* aWidget, const LayoutDeviceIntPoint& aAt) {
+  nsIRollupListener* listener = nsIWidget::GetActiveRollupListener();
+  if (!listener) {
+    return;
+  }
+  nsCOMPtr<nsIWidget> rollup = listener->GetRollupWidget();
+  if (!rollup || rollup == aWidget) {
+    return;
+  }
+  AutoTArray<nsIWidget*, 8> chain;
+  listener->GetSubmenuWidgetChain(&chain);
+  if (chain.Contains(aWidget)) {
+    return;
+  }
+  LayoutDeviceIntPoint point = aAt + aWidget->WidgetToScreenOffset();
+  nsIRollupListener::RollupOptions options;
+  options.mPoint = &point;
+  listener->Rollup(options);
+}
+
+void SendButton(HeadlessWidget* aWidget, EventMessage aMessage,
+                const LayoutDeviceIntPoint& aAt, MouseButton aButton,
+                int aClicks) {
+  WidgetMouseEvent event(true, aMessage, aWidget, WidgetMouseEvent::eReal);
+  event.mRefPoint = aAt;
+  event.mButton = aButton;
+  event.mButtons = sButtons;
+  event.mClickCount = aClicks;
+  event.AssignEventTime(WidgetEventTime());
+  aWidget->DispatchInputEvent(&event);
+}
+
+void HandleMouse(HeadlessWidget* aWidget, const dosxc_gui_event& aEvent) {
+  LayoutDeviceIntPoint at(aEvent.x, aEvent.y);
+  switch (aEvent.kind) {
+    case DOSXC_M_MOVE: {
+      WidgetMouseEvent event(true, eMouseMove, aWidget, WidgetMouseEvent::eReal);
+      event.mRefPoint = at;
+      event.mButtons = sButtons;
+      event.AssignEventTime(WidgetEventTime());
+      aWidget->DispatchInputEvent(&event);
+      break;
+    }
+    case DOSXC_M_DOWN:
+    case DOSXC_M_DOUBLE:
+      RollupIfOutside(aWidget, at);
+      sButtons = MouseButtonsFlag::ePrimaryFlag;
+      SendButton(aWidget, eMouseDown, at, MouseButton::ePrimary,
+                 aEvent.kind == DOSXC_M_DOUBLE ? 2 : 1);
+      break;
+    case DOSXC_M_UP:
+      sButtons = 0;
+      SendButton(aWidget, eMouseUp, at, MouseButton::ePrimary, 1);
+      break;
+    case DOSXC_M_RIGHT: {
+      RollupIfOutside(aWidget, at);
+      sButtons = MouseButtonsFlag::eSecondaryFlag;
+      SendButton(aWidget, eMouseDown, at, MouseButton::eSecondary, 1);
+      sButtons = 0;
+      SendButton(aWidget, eMouseUp, at, MouseButton::eSecondary, 1);
+      WidgetPointerEvent menu(true, eContextMenu, aWidget);
+      menu.mRefPoint = at;
+      menu.mButton = MouseButton::eSecondary;
+      menu.AssignEventTime(WidgetEventTime());
+      aWidget->DispatchInputEvent(&menu);
+      break;
+    }
+    case DOSXC_M_WHEEL: {
+      WidgetWheelEvent event(true, eWheel, aWidget);
+      event.mRefPoint = at;
+      event.mDeltaMode = dom::WheelEvent_Binding::DOM_DELTA_LINE;
+      event.mDeltaY = -aEvent.value * 3;
+      event.mLineOrPageDeltaY = -aEvent.value * 3;
+      event.AssignEventTime(WidgetEventTime());
+      aWidget->DispatchInputEvent(&event);
+      break;
+    }
+  }
+}
+
+void SendKey(HeadlessWidget* aWidget, uint32_t aKeyCode, KeyNameIndex aName,
+             char16_t aChar, Modifiers aModifiers) {
+  for (EventMessage message : {eKeyDown, eKeyPress, eKeyUp}) {
+    WidgetKeyboardEvent event(true, message, aWidget);
+    event.mModifiers = aModifiers;
+    event.mKeyCode = aKeyCode;
+    event.mKeyNameIndex = aName;
+    if (aChar) {
+      event.mKeyNameIndex = KEY_NAME_INDEX_USE_STRING;
+      event.mKeyValue.Assign(aChar);
+      if (message == eKeyPress) {
+        event.mCharCode = aChar;
+        event.mKeyCode = 0;
+      }
+    }
+    event.AssignEventTime(WidgetEventTime());
+    aWidget->DispatchInputEvent(&event);
+  }
+}
+
+void HandleKey(HeadlessWidget* aWindow, int aKey, int aHeld) {
+  // Text goes to the window Gecko considers active, whichever desktop window
+  // (a popup, say) has the keyboard.
+  RefPtr<HeadlessWidget> target = HeadlessWidget::GetActiveWindow();
+  if (!target) {
+    target = aWindow;
+  }
+  Modifiers held = 0;
+  if (aHeld & 1) {
+    held |= MODIFIER_SHIFT;
+  }
+  if (aHeld & 2) {
+    held |= MODIFIER_CONTROL;
+  }
+  if (aHeld & 4) {
+    held |= MODIFIER_ALT;
+  }
+  static const struct {
+    int mKey;
+    uint32_t mCode;
+    KeyNameIndex mName;
+  } kSpecial[] = {
+      {0x101, NS_VK_UP, KEY_NAME_INDEX_ArrowUp},
+      {0x102, NS_VK_DOWN, KEY_NAME_INDEX_ArrowDown},
+      {0x103, NS_VK_RIGHT, KEY_NAME_INDEX_ArrowRight},
+      {0x104, NS_VK_LEFT, KEY_NAME_INDEX_ArrowLeft},
+      {0x105, NS_VK_HOME, KEY_NAME_INDEX_Home},
+      {0x106, NS_VK_END, KEY_NAME_INDEX_End},
+      {0x107, NS_VK_INSERT, KEY_NAME_INDEX_Insert},
+      {0x108, NS_VK_DELETE, KEY_NAME_INDEX_Delete},
+      {0x109, NS_VK_PAGE_UP, KEY_NAME_INDEX_PageUp},
+      {0x10a, NS_VK_PAGE_DOWN, KEY_NAME_INDEX_PageDown},
+      {8, NS_VK_BACK, KEY_NAME_INDEX_Backspace},
+      {9, NS_VK_TAB, KEY_NAME_INDEX_Tab},
+      {10, NS_VK_RETURN, KEY_NAME_INDEX_Enter},
+      {13, NS_VK_RETURN, KEY_NAME_INDEX_Enter},
+      {27, NS_VK_ESCAPE, KEY_NAME_INDEX_Escape},
+  };
+  for (const auto& special : kSpecial) {
+    if (special.mKey == aKey) {
+      SendKey(target, special.mCode, special.mName, 0, held);
+      return;
+    }
+  }
+  if (aKey >= 0x10b && aKey <= 0x116) {  // F1 to F12
+    SendKey(target, NS_VK_F1 + uint32_t(aKey - 0x10b),
+            KeyNameIndex(KEY_NAME_INDEX_F1 + (aKey - 0x10b)), 0, held);
+    return;
+  }
+  if (aKey >= 1 && aKey <= 26) {  // Ctrl and a letter
+    SendKey(target, NS_VK_A + uint32_t(aKey - 1), KEY_NAME_INDEX_USE_STRING,
+            char16_t(((aHeld & 1) ? 'A' : 'a') + aKey - 1),
+            held | MODIFIER_CONTROL);
+    return;
+  }
+  if (aKey >= 32 && aKey < 256) {
+    uint32_t code = 0;
+    if (aKey >= 'a' && aKey <= 'z') {
+      code = NS_VK_A + uint32_t(aKey - 'a');
+    } else if (aKey >= 'A' && aKey <= 'Z') {
+      code = NS_VK_A + uint32_t(aKey - 'A');
+    } else if (aKey >= '0' && aKey <= '9') {
+      code = NS_VK_0 + uint32_t(aKey - '0');
+    } else if (aKey == ' ') {
+      code = NS_VK_SPACE;
+    }
+    SendKey(target, code, KEY_NAME_INDEX_USE_STRING, char16_t(aKey), held);
+  }
+}
+
+void Handle(const dosxc_gui_event& aEvent) {
+  Entry* entry = Find(aEvent.window);
+  if (!entry) {
+    return;
+  }
+  RefPtr<HeadlessWidget> widget = entry->mWidget;
+  switch (aEvent.type) {
+    case DOSXC_EV_MOUSE:
+      HandleMouse(widget, aEvent);
+      break;
+    case DOSXC_EV_KEY:
+      HandleKey(widget, aEvent.value, aEvent.kind);
+      break;
+    case DOSXC_EV_CLOSE:
+      if (nsIWidgetListener* listener = widget->GetWidgetListener()) {
+        listener->RequestWindowClose(widget);
+      }
+      break;
+    case DOSXC_EV_RESIZE:
+      dosxc_gui_accept_size(entry->mGui, aEvent.x, aEvent.y);
+      widget->Resize(DesktopSize(aEvent.x, aEvent.y), true);
+      break;
+  }
+}
+
+}  // namespace
+
+bool Available() {
+  if (sConnected < 0) {
+    sConnected = dosxc_gui_connect() == 0 ? 1 : 0;
+  }
+  return sConnected == 1;
+}
+
+void ScreenSize(int* aWidth, int* aHeight) { dosxc_gui_screen(aWidth, aHeight); }
+
+void ShowWindow(HeadlessWidget* aWidget, bool aShow, bool aPopup) {
+  if (!Available()) {
+    return;
+  }
+  if (!aShow) {
+    CloseWindow(aWidget);
+    return;
+  }
+  if (aWidget->mDesktopWindow) {
+    return;
+  }
+  LayoutDeviceIntRect bounds = aWidget->GetBounds();
+  if (!aPopup) {
+    // Fit the screen, leaving room for the frame and taskbar.
+    int screenWidth, screenHeight;
+    ScreenSize(&screenWidth, &screenHeight);
+    if (screenWidth > 0) {
+      int width = std::min(bounds.width, screenWidth - 8);
+      int height = std::min(bounds.height, screenHeight - 60);
+      if (width != bounds.width || height != bounds.height) {
+        aWidget->Resize(DesktopSize(width, height), true);
+        bounds = aWidget->GetBounds();
+      }
+    }
+  }
+  if (bounds.width <= 0 || bounds.height <= 0) {
+    return;
+  }
+  void* gui = dosxc_gui_open(bounds.x, bounds.y, bounds.width, bounds.height,
+                             aPopup                            ? ""
+                             : aWidget->mDesktopTitle.IsEmpty() ? "DOSfox"
+                                                                : aWidget->mDesktopTitle.get(),
+                             aPopup ? 1 : 0);
+  if (gui) {
+    aWidget->mDesktopWindow = gui;
+    sWindows.AppendElement(Entry{gui, aWidget, bounds.x, bounds.y});
+  }
+}
+
+void CloseWindow(HeadlessWidget* aWidget) {
+  if (!aWidget->mDesktopWindow) {
+    return;
+  }
+  void* gui = aWidget->mDesktopWindow;
+  aWidget->mDesktopWindow = nullptr;
+  sWindows.RemoveElementsBy(
+      [gui](const Entry& aEntry) { return aEntry.mGui == gui; });
+  dosxc_gui_close(gui);
+}
+
+void SetTitle(HeadlessWidget* aWidget, const nsAString& aTitle) {
+  // The desktop's title font has only ASCII.
+  nsAutoCString title;
+  for (uint32_t i = 0; i < aTitle.Length(); ++i) {
+    char16_t c = aTitle[i];
+    title.Append(c >= 32 && c < 127 ? char(c) : '-');
+  }
+  aWidget->mDesktopTitle = title;
+  if (aWidget->mDesktopWindow) {
+    dosxc_gui_title(aWidget->mDesktopWindow, title.get());
+  }
+}
+
+void WidgetResized(HeadlessWidget* aWidget, int aWidth, int aHeight) {
+  if (aWidget->mDesktopWindow && aWidth > 0 && aHeight > 0) {
+    dosxc_gui_size(aWidget->mDesktopWindow, aWidth, aHeight);
+  }
+}
+
+void WidgetMoved(HeadlessWidget* aWidget, int aX, int aY) {
+  if (!aWidget->mDesktopWindow) {
+    return;
+  }
+  if (Entry* entry = Find(aWidget->mDesktopWindow)) {
+    entry->mX = aX;
+    entry->mY = aY;
+  }
+  dosxc_gui_place(aWidget->mDesktopWindow, aX, aY);
+}
+
+already_AddRefed<gfx::DrawTarget> StartDrawing(HeadlessWidget* aWidget,
+                                               const gfx::IntSize& aClient) {
+  void* gui = aWidget->mDesktopWindow;
+  if (!gui) {
+    return nullptr;
+  }
+  int width, height;
+  uint32_t* pixels = dosxc_gui_pixels(gui, &width, &height);
+  if (!pixels || width != aClient.width || height != aClient.height) {
+    return nullptr;  // mid-resize: the next frame will fit
+  }
+  return gfx::Factory::CreateDrawTargetForData(
+      gfx::BackendType::SKIA, reinterpret_cast<uint8_t*>(pixels),
+      gfx::IntSize(width, height), width * 4, gfx::SurfaceFormat::B8G8R8X8);
+}
+
+void EndDrawing(HeadlessWidget* aWidget) {
+  if (void* gui = aWidget->mDesktopWindow) {
+    dosxc_gui_presented(gui);
+  }
+}
+
+bool Pump() {
+  if (!Available()) {
+    return false;
+  }
+  bool did = false;
+  dosxc_gui_event event;
+  while (dosxc_gui_next_event(&event)) {
+    Handle(event);
+    did = true;
+  }
+  // The user moves windows on the desktop; Gecko places popups from this.
+  for (uint32_t i = 0; i < sWindows.Length(); ++i) {
+    Entry& entry = sWindows[i];
+    int x, y;
+    dosxc_gui_position(entry.mGui, &x, &y);
+    if (x != entry.mX || y != entry.mY) {
+      entry.mX = x;
+      entry.mY = y;
+      RefPtr<HeadlessWidget> widget = entry.mWidget;
+      widget->Move(DesktopPoint(x, y));
+    }
+  }
+  return did;
+}
+
+}  // namespace mozilla::widget::dosxc
