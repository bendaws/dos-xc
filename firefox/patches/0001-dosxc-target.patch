+void dosxc_gui_place(void* window, int x, int y);        // a popup
+void dosxc_gui_position(void* window, int* x, int* y);
+uint32_t* dosxc_gui_pixels(void* window, int* w, int* h);
+void dosxc_gui_presented(void* window);
+int dosxc_gui_next_event(struct dosxc_gui_event* event);
+
+#ifdef __cplusplus
+}
