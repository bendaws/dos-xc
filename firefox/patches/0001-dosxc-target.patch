diff --git a/browser/app/nsBrowserApp.cpp b/browser/app/nsBrowserApp.cpp
index 1fbef26996..bc19bb22d7 100644
--- a/browser/app/nsBrowserApp.cpp
+++ b/browser/app/nsBrowserApp.cpp
@@ -3,6 +3,11 @@
  * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
 
 #include "nsXULAppAPI.h"
+#ifdef MOZ_WIDGET_DOSXC
+#  include <dlfcn.h>
+#  include <sys/stat.h>
+#  include <unistd.h>
+#endif
 #include "mozilla/XREAppData.h"
 #include "XREChildData.h"
 #include "XREShellData.h"
@@ -338,6 +343,42 @@ static void ExpandFileDescriptorTable() {
 #endif
 
 int main(int argc, char* argv[], char* envp[]) {
+#ifdef MOZ_WIDGET_DOSXC
+  // DOS-XC's own settings, before anything reads them.  HOME is a POSIX path
+  // here: the system's own is a DOS one, which Gecko cannot use.
+  // Gecko's paths have no drive letter: they mean the current drive, so make
+  // that the one Firefox is on.
+  Dl_info self;
+  if (dladdr(reinterpret_cast<void*>(&main), &self) && self.dli_fname &&
+      self.dli_fname[0] && self.dli_fname[1] == ':') {
+    char root[4] = {self.dli_fname[0], ':', '/', 0};
+    chdir(root);
+  }
+  setenv("MOZ_HEADLESS", "1", 0);
+  setenv("MOZ_CRASHREPORTER_DISABLE", "1", 0);
+  const char* home = getenv("HOME");
+  if (!home || home[0] != '/') {
+    char path[1024];
+    ssize_t length = readlink("/proc/self/exe", path, sizeof(path) - 8);
+    if (length > 0) {
+      path[length] = 0;
+      if (char* slash = strrchr(path, '/')) {
+        strcpy(slash + 1, "home");
+        setenv("HOME", path, 1);
+      }
+    }
+  }
+  const char* temporary = getenv("TMPDIR");
+  if (!temporary || temporary[0] != '/') {
+    home = getenv("HOME");
+    if (home) {
+      char path[1024];
+      snprintf(path, sizeof(path), "%s/tmp", home);
+      mkdir(path, 0700);
+      setenv("TMPDIR", path, 1);
+    }
+  }
+#endif
 #if defined(XP_UNIX)
   ReserveDefaultFileDescriptors();
 #endif
