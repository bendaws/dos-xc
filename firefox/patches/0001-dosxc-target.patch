@@ -0,0 +1,30 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef nsAppShell_h__
+#define nsAppShell_h__
+
+#include "mozilla/CondVar.h"
+#include "mozilla/Mutex.h"
+#include "nsBaseAppShell.h"
+
+// The main event loop.  DOS-XC has no native event queue to wait on yet, so
+// waiting is a condition variable that other threads signal.
+class nsAppShell final : public nsBaseAppShell {
+ public:
+  nsAppShell();
+  nsresult Init();
+
+ protected:
+  ~nsAppShell() override = default;
+  void ScheduleNativeEventCallback() override;
+  bool ProcessNextNativeEvent(bool aMayWait) override;
+
+ private:
+  mozilla::Mutex mMutex;
+  mozilla::CondVar mCondVar;
+  bool mPending = false;
+};
+
+#endif
