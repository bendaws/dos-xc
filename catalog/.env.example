# The supplied Gunicorn config and deploy/manage.py load this file automatically.
# For other launch methods, export these variables into the process environment.
CATALOG_SECRET_KEY=CHANGE_ME
CATALOG_BASE_URL=https://dos-packages.bendaws.net
CATALOG_DATA_DIR=/var/lib/dosxc-catalog
CATALOG_COOKIE_SECURE=1
# Set to 1 only when the server is reachable exclusively through your reverse proxy.
CATALOG_PROXY_HOPS=1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# For LOCAL testing with python -m smtpd / aiosmtpd only:
# SMTP_HOST=127.0.0.1 SMTP_PORT=1025 SMTP_SECURITY=none
# CATALOG_BASE_URL=http://127.0.0.1:5000 CATALOG_COOKIE_SECURE=0
