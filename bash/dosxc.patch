+#if defined (__dosxc__)
+/* Batch files and 16-bit DOS programs run through the DOS-XC command shell. */
+static int
+dosxc_for_command_shell (const char *command)
+{
+  size_t n = strlen (command);
+  char magic[2], *with;
+  int fd, got;
+
+  if (n > 4 && (strcasecmp (command + n - 4, ".bat") == 0 || strcasecmp (command + n - 4, ".cmd") == 0 ||
+		strcasecmp (command + n - 4, ".com") == 0))
+    return 1;
+  fd = open (command, O_RDONLY);
+  if (fd < 0 && strchr (command, '.') == 0)
+    {
+      with = (char *)xmalloc (n + 5);
+      strcpy (with, command);
+      strcat (with, ".EXE");
+      fd = open (with, O_RDONLY);
+      free (with);
+    }
+  if (fd < 0)
+    return 0;
+  got = read (fd, magic, 2);
+  close (fd);
+  return got == 2 && magic[0] == 'M' && magic[1] == 'Z';
+}
+
+static void
+dosxc_execve_command_shell (const char *command, char **args, char **env)
+{
+  char *comspec = getenv ("COMSPEC"), **argv, *dos;
+  int n, i;
+
+  for (n = 0; args[n]; n++)
+    ;
+  argv = (char **)xmalloc ((n + 3) * sizeof (char *));
+  dos = savestring (command);
+  for (i = 0; dos[i]; i++)
+    if (dos[i] == '/')
+      dos[i] = '\\';
+  argv[0] = "COMMAND.EXE";
+  argv[1] = "/C";
+  argv[2] = dos;
+  for (i = 1; i <= n; i++)
+    argv[i + 2] = args[i];
+  execve (comspec && *comspec ? comspec : "/SYSTEM/COMMAND.EXE", argv, env);
+}
+#endif
+
 /* Call execve (), handling interpreting shell scripts, and handling
    exec failures. */
 int
@@ -6130,6 +6195,11 @@
   size_t larray;
 
   SETOSTYPE (0);		/* Some systems use for USG/POSIX semantics */
+#if defined (__dosxc__)
+  if (dosxc_for_command_shell (command))
+    dosxc_execve_command_shell (command, args, env);
+  else
+#endif
   execve (command, args, env);
   i = errno;			/* error from execve() */
   CHECK_TERMSIG;
